# Copy to .env and adjust. Do not commit real secrets.

# --- MySQL container ---
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=eyened_database
MYSQL_USER=eyened
MYSQL_PASSWORD=change_me

# InnoDB buffer pool. MySQL's default is 128M, which is far too small for this
# database (8.2 GB); 2G measured 4.2x faster on a bulk insert. Size it to the
# host, not to this file.
EYENED_DATABASE_BUFFER_POOL_SIZE=2G

# --- Host ports ---
EYENED_DATABASE_PORT=3306
EYENED_ADMINER_PORT=8080

# --- Used by save_dump.sh / load scripts ---
EYENED_DATABASE_USER=eyened
EYENED_DATABASE_PASSWORD=change_me
