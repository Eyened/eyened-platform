# Framework build output — regenerated by `svelte-kit sync` / `vite build`
.svelte-kit/
build/
dist/

# Dependency + lock artifacts
node_modules/
package-lock.json

# Generator output per the Makefile (gen-openapi -> openapi.json, gen-types ->
# openapi.ts) — reformatting these would re-diverge on the next regen and make
# the gate flaky. Hand-written files under src/types/ are NOT ignored.
src/types/openapi.ts
src/types/openapi.json

# Generator output, same rule: eslint writes this file (2-space) whenever anyone
# runs --suppress-rule/--prune-suppressions. Prettier wants 4-space, so if it
# owned this file every prune would leave the tree prettier-dirty and `npm run
# lint` would fail on the very command the ratchet doc tells you to run.
# ESLint owns its own baseline.
eslint-suppressions.json

# GLSL shader sources. `.frag` is mapped by prettier to its babel/JS parser, so
# it throws `SyntaxError` on valid GLSL (e.g. `for(int i…)`) and exits 2 — this
# one is load-bearing. `.vert`/`.glsl` have no matching prettier parser today
# and are skipped as a no-op; they're listed alongside `.frag` for consistency
# and to future-proof against prettier adding parsers for them.
*.frag
*.vert
*.glsl
