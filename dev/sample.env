# environment variables for use with development setup

# ---- API authentication ----
EYENED_API_SECRET_KEY=
EYENED_API_PUBLIC_AUTH_DISABLED=false
# The account the PUBLIC_AUTH_DISABLED dev bypass resolves, and the one
# `eorm init-admin` bootstraps by default. The bypass needs no password; set
# ADMIN_PASSWORD only if something logs in as the admin over HTTP (e.g. the
# image importer).
# EYENED_API_ADMIN_USERNAME=admin
# EYENED_API_ADMIN_PASSWORD=
EYENED_API_DEBUG=true

# ---- OIDC (optional, see dev/keycloak/README.md) ----
# EYENED_API_AUTH_OIDC_ENABLED=true
# EYENED_OIDC_CLIENT_ID=eyened-platform
# EYENED_OIDC_CLIENT_SECRET=eyened-dev-secret   # must match dev/keycloak/realm-eyened-dev.json.template
# EYENED_OIDC_PROVIDER_NAME=Keycloak
# EYENED_OIDC_CREATE_NEW_ACCOUNTS=true

# This is used by the api to write and read segmentations (<EYENED_STORAGE_ROOT>/segmentations.zarr)
# Should be accessible and writable within the server container
EYENED_STORAGE_ROOT=

# ---- Database  ----
MYSQL_ROOT_PASSWORD= 

EYENED_DATABASE_USER=root
EYENED_DATABASE_PASSWORD=${MYSQL_ROOT_PASSWORD}

# ---- Dev ports / routing ----
# Hostname or IP used in the browser (only required for OIDC)
DEV_PUBLIC_HOST=
# main application entry port
DEV_NGINX_PORT=

# --optionally --
# if exposing the database on host system
DEV_DATABASE_PORT=

# for exposing redis for external workers
DEV_REDIS_PORT=
