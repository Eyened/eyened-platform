# environment variables for use with development setup

# ---- API authentication ----
EYENED_API_SECRET_KEY=
EYENED_API_PUBLIC_AUTH_DISABLED=false
EYENED_API_DEBUG=true

# Names the account the dev-auth bypass logs in as, and the account
# `eorm init-admin` bootstraps. Keep both in agreement: pass
# EYENED_API_ADMIN_USERNAME to `init-admin --username` too.
EYENED_API_ADMIN_USERNAME=admin
# Read by `eorm init-admin`, not the server. Optional: leave unset (or blank)
# to disable password login for the bootstrapped account.
EYENED_API_ADMIN_PASSWORD=

# ---- API concurrency (optional) ----
# Interdependent, and validated at startup: threadpool_limit must not exceed
# pool_size + max_overflow, or request threads queue behind SQLAlchemy's
# default 30s pool_timeout. Each server process has its own pool and can
# open up to (pool_size + max_overflow) connections; keep the total across
# all processes under the database's max_connections, counting the RQ worker
# and importer too.
# EYENED_API_THREADPOOL_LIMIT=16
# EYENED_API_POOL_SIZE=16
# EYENED_API_MAX_OVERFLOW=4

# ---- OIDC (optional, see dev/keycloak/README.md) ----
# EYENED_API_AUTH_OIDC_ENABLED=true
# EYENED_OIDC_CLIENT_ID=eyened-platform
# EYENED_OIDC_CLIENT_SECRET=eyened-dev-secret   # must match dev/keycloak/realm-eyened-dev.json.template
# EYENED_OIDC_PROVIDER_NAME=Keycloak
# EYENED_OIDC_CREATE_NEW_ACCOUNTS=true

# This is used by the api to write and read segmentations (<EYENED_STORAGE_ROOT>/segmentations.zarr)
# Should be accessible and writable within the server container
EYENED_STORAGE_ROOT=

# ---- Database  ----
MYSQL_ROOT_PASSWORD= 

EYENED_DATABASE_USER=root
EYENED_DATABASE_PASSWORD=${MYSQL_ROOT_PASSWORD}

# Skip alembic's interactive target-database confirmation. For non-interactive
# deploy automation and CI only -- never set this in a file you might point at
# production.
# EYENED_ALEMBIC_ASSUME_YES=1

# ---- Dev ports / routing ----
# Hostname or IP used in the browser (only required for OIDC)
DEV_PUBLIC_HOST=
# main application entry port
DEV_NGINX_PORT=

# --optionally --
# if exposing the database on host system
DEV_DATABASE_PORT=

# for exposing redis for external workers
DEV_REDIS_PORT=
