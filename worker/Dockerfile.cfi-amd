# CUDA 12.8 + PyTorch 2.7 required for Blackwell GPUs (e.g. RTX 5090, sm_120).
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

SHELL ["/bin/bash", "-c"]

# System deps for OpenCV (common inference dependency chain)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Base server deps (includes rq/redis/etc.)
COPY server/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# ORM + server code (worker imports task entrypoints from server.utils.tasks)
COPY orm /app/orm
RUN pip install --no-cache-dir -e /app/orm
COPY server /app/server

# AMD segmentation dependency (provides `cfi_amd.processor`)
RUN pip install --no-cache-dir "git+https://github.com/Eyened/cfi-amd.git"

# Bake GitHub release weights (avoids ~1GB download on every `docker run --rm`).
ENV CFI_AMD_MODELS_DIR=/models/cfi-amd
RUN python - <<'EOF'
from pathlib import Path

from cfi_amd.resources import ensure_models_downloaded

ensure_models_downloaded(Path("/models/cfi-amd"))
EOF

ENV PYTHONPATH=/app
WORKDIR /app

CMD ["python", "-m", "server.rq_worker"]

