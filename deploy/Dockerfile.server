FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libxcb1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Set as an environment variable rather than passing --no-cache-dir on each
# install: PEP 517 build isolation spawns a *nested* pip to install the build
# requirements, and that subprocess does not inherit command-line flags. With
# the flags alone, that nested pip still left ~1.3 MB of http cache behind.
ENV PIP_NO_CACHE_DIR=1

# One resolution for orm and the server together. Two sequential installs let
# the second break the first one's pins while pip prints ERROR and exits 0, so
# the image built green with a dependency set its own constraints reject.
# Manifest before source: copying the whole server tree here would invalidate
# the install on every .py edit, costing a full dependency reinstall for a
# one-character change.
COPY orm /app/orm
COPY server/requirements.txt /app/server/requirements.txt
RUN pip install -r /app/server/requirements.txt -e /app/orm

COPY server /app/server

EXPOSE 8000

WORKDIR /app

# One image, two run commands. This default is the production one; the dev
# compose layer replaces it with `uvicorn --reload` over bind-mounted sources.
# Shell form so ${WORKERS} is expanded at runtime.
CMD gunicorn server.main:app \
    --workers ${WORKERS:-4} \
    --worker-class uvicorn.workers.UvicornWorker \
    --bind 0.0.0.0:8000 \
    --log-level ${LOG_LEVEL:-info} \
    --access-logfile - \
    --error-logfile -
