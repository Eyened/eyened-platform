# Development frontend: vite dev server with hot reload over a bind-mounted
# source tree. Production does not use this image at all — the built SPA is
# baked into the fileserver image instead (Dockerfile.fileserver).
FROM node:24-slim
WORKDIR /app/client

# Manifests only. The client source is deliberately NOT copied: the dev compose
# layer bind-mounts it over this path at runtime, so a copy would be 5 MB of
# unreachable dead weight that also invalidated the npm ci layer on every
# source edit.
#
# Plain `npm ci` — NOT `npm ci --only=production`. vite is a devDependency and
# is the entire point of this image.
COPY client/package.json client/package-lock.json ./

# The stamp records which lockfile these modules were installed from. It lives
# inside node_modules so it travels with the named volume that seeds from this
# image; the entrypoint compares it against the mounted lockfile and reinstalls
# on a mismatch. Writing it here means a freshly seeded volume does NOT
# reinstall on first boot. The npm cache is 220 MB and is not needed at runtime.
RUN npm ci \
    && md5sum package-lock.json | cut -d' ' -f1 > node_modules/.lock-stamp \
    && npm cache clean --force

COPY deploy/entrypoint-client.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 5173
ENTRYPOINT ["/entrypoint.sh"]
