# Copy to deploy/.env and fill the secrets. Compose reads it from deploy/.

# ---- Which stack -------------------------------------------------------------
# Production, bundled database:
COMPOSE_FILE=compose.yaml:compose.prod.yaml
COMPOSE_PROFILES=local-db
# Development (hot reload, source mounted):
# COMPOSE_FILE=compose.yaml:compose.dev.yaml
# COMPOSE_PROFILES=local-db
# External database (either stack): an empty COMPOSE_PROFILES, and
# EYENED_DATABASE_* below pointing at that server.
#
# Optional layers, appended to COMPOSE_FILE:
#   :compose.storage.yaml     image datasets (copy compose.storage.example.yaml)
#   :compose.workers.yaml     RQ workers; GPU workers also need a profile:
#                             gpu-inference, gpu-cfi-amd, gpu-layer-segmentation
#   :compose.oidc.yaml        bundled Keycloak (keycloak/README.md)
#   :compose.host-ports.yaml  MySQL and Redis on 127.0.0.1

# ---- Secrets -----------------------------------------------------------------
# Required: compose will not start while any of these four is empty. That
# includes MYSQL_ROOT_PASSWORD on an external database, where nothing uses it.
# Generate each with `openssl rand -hex 32`, a fresh set per new deployment.
EYENED_API_SECRET_KEY=
EYENED_REDIS_PASSWORD=
MYSQL_ROOT_PASSWORD=
EYENED_DATABASE_PASSWORD=
# The password you log in with as EYENED_API_ADMIN_USERNAME. init reads it only
# while the database has no accounts, and fails if it is empty then; after that
# it is ignored, so changing it does not change the account's password.
EYENED_API_ADMIN_PASSWORD=
# Required with compose.oidc.yaml: the Keycloak admin console password.
# KEYCLOAK_ADMIN_PASSWORD=

# ---- This stack on a shared host ---------------------------------------------
# Give each stack on a machine its own name and port.
COMPOSE_PROJECT_NAME=eyened
HTTP_PORT=8080
# CPU caps, to stop this stack starving the others. Unset is 0, meaning no cap;
# a value above the host's core count is refused when the container is created,
# so set these per machine rather than committing a number.
# EYENED_SERVER_CPUS=4.0
# EYENED_DATABASE_CPUS=2.0

# ---- Database ------------------------------------------------------------------
EYENED_DATABASE_USER=eyened
EYENED_DATABASE_DATABASE=eyened_database
EYENED_DATABASE_HOST=database
EYENED_DATABASE_PORT=3306
# Unset = a Docker volume, deleted by `docker compose down -v`. An absolute path
# keeps the bundled database on storage you control.
# DB_DATA_PATH=/srv/eyened/db
# Size to the host; 2G measured 4.2x faster than MySQL's 128M on a bulk insert.
EYENED_DATABASE_BUFFER_POOL_SIZE=2G
# `up` never migrates an existing schema; init only reports what is pending, and
# you migrate by hand (https://eyened.github.io/eyened-platform/deployment/operations,
# "Day-to-day"). An empty database is still created and seeded. true migrates on
# every `up` -- do not set it on a stack pointed at a shared or production database.
EYENED_AUTO_MIGRATE=false
# Where `docker compose run --rm xtrabackup` writes; default deploy/backups.
# BACKUP_PATH=/srv/eyened/backups
# With compose.host-ports.yaml:
# DB_PUBLISH_PORT=13306
# REDIS_PUBLISH_PORT=16379

# ---- Redis ---------------------------------------------------------------------
# These defaults reach the bundled redis. A workers-only stack on a GPU host must
# set HOST and PORT to the machine running the platform
# (https://eyened.github.io/eyened-platform/deployment/production, "Workers").
# EYENED_REDIS_HOST=redis
# EYENED_REDIS_PORT=6379
# compose.workers.yaml only.
# EYENED_REDIS_DB=0

# ---- Storage -------------------------------------------------------------------
# Thumbnails and segmentations. Unset = a Docker volume.
# PLATFORM_STORAGE_PATH=/srv/eyened/storage
# Image datasets: StorageBackend.Key -> /data/<key>, matching compose.storage.yaml.
# EYENED_STORAGE_MOUNTS={"my-dataset":"/data/my-dataset"}

# ---- API -------------------------------------------------------------------------
EYENED_API_ADMIN_USERNAME=admin
# true skips login and acts as EYENED_API_ADMIN_USERNAME. Development only.
EYENED_API_PUBLIC_AUTH_DISABLED=false
EYENED_API_DEBUG=false
EYENED_API_AUTH_PASSWORD_ENABLED=true
# Each gunicorn worker holds up to POOL_SIZE + MAX_OVERFLOW connections; keep
# WORKERS times that under MySQL's max_connections. THREADPOOL_LIMIT must not
# exceed POOL_SIZE + MAX_OVERFLOW, or the server refuses to start.
WORKERS=4
EYENED_API_THREADPOOL_LIMIT=16
EYENED_API_POOL_SIZE=16
EYENED_API_MAX_OVERFLOW=4
EYENED_API_POOL_TIMEOUT=5
# Concurrent Argon2 hashes per worker, 64 MiB each.
EYENED_API_PASSWORD_HASH_CONCURRENCY=4

# ---- Bundled Keycloak address (compose.oidc.yaml only) -------------------------
# Read ONLY by the bundled Keycloak layer. Nothing else reads these -- there is no
# platform-wide public-origin setting. Behind a TLS terminator, forward
# X-Forwarded-Proto; nginx prefers it over its own scheme.
PUBLIC_HOST=localhost
# The public https origin of the bundled Keycloak, no trailing slash.
# PUBLIC_URL=https://eyened.example.org

# ---- OIDC (all three URLs change together) --------------------------------------
# EYENED_API_AUTH_OIDC_ENABLED=true
# EYENED_OIDC_CLIENT_ID=eyened-platform
# A secret, issued by the provider rather than generated here; the value below is
# the bundled Keycloak realm's, and is not usable against any other provider.
# EYENED_OIDC_CLIENT_SECRET=eyened-dev-secret
# EYENED_OIDC_PROVIDER_NAME=Keycloak
# EYENED_OIDC_CREATE_NEW_ACCOUNTS=true
# Bundled Keycloak (compose.oidc.yaml):
# KEYCLOAK_PORT=8180
# EYENED_OIDC_METADATA_URL=http://<PUBLIC_HOST>:8180/realms/eyened-dev/.well-known/openid-configuration
# EYENED_OIDC_REDIRECT_URL=http://<PUBLIC_HOST>:<HTTP_PORT>/users/oidc-callback
# EYENED_OIDC_ADDITIONAL_TOKEN_VALIDATIONS=iss=http://<PUBLIC_HOST>:8180/realms/eyened-dev
# External provider, e.g. SURFconext:
# EYENED_OIDC_METADATA_URL=https://connect.surfconext.nl/.well-known/openid-configuration
# EYENED_OIDC_REDIRECT_URL=https://eyened.example.org/users/oidc-callback
# EYENED_OIDC_ADDITIONAL_TOKEN_VALIDATIONS=iss=https://connect.surfconext.nl

# ---- Workers -------------------------------------------------------------------
# EYENED_RQ_QUEUES_CFI_ROI=cfi-roi,default
# EYENED_RQ_QUEUES_INFERENCE=cfi-keypoints,cfi-odfd,cfi-quality
