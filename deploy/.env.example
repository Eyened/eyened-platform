# deploy/.env.example — the template deploy/.env is built from. The entry
# points do that for you, ONCE: they copy this file and append a block holding
# COMPOSE_FILE and five generated secrets. Nothing ever rewrites deploy/.env
# afterwards, so anything you edit there stays edited; to start over, delete it
# and re-run.
#
# Working local defaults: `./eyened install` and `./eyened up` both work from a
# clean clone with zero edits.
#
# The five secrets are ABSENT from this file rather than shipped as
# placeholders. Copying it to deploy/.env by hand therefore fails at
# 'docker compose up' on compose.yaml's own ${MYSQL_ROOT_PASSWORD:?...} —
# loudly, and before anything is built — instead of booting the whole stack on
# a password published in this repository.

# ---- Which layers and profiles this stack runs -----------------------------
# COMPOSE_FILE must name EVERY layer — there is no implicit discovery here.
# (Compose auto-loads a file named compose.override.yaml when COMPOSE_FILE is
# unset; the dev layer is called compose.dev.yaml precisely so that magic name
# never enters into it.)
#
# The entry points do NOT rewrite this line. They append their own
# COMPOSE_FILE at the end of deploy/.env, and compose reads the LAST
# assignment — so the value below is what a hand-copied .env gets, and a layer
# you append to the generated one at the bottom of that file is permanent.
#
# Developer stack (`./eyened up`):
COMPOSE_FILE=compose.yaml:compose.dev.yaml:compose.storage.yaml
# Client install (`./eyened install`) — the same minus the dev override, plus prod:
# COMPOSE_FILE=compose.yaml:compose.storage.yaml:compose.prod.yaml
# Append :compose.oidc.yaml to COMPOSE_FILE above to run the bundled Keycloak,
# :compose.host-ports.yaml to publish the database and Redis on loopback, and
# :compose.workers.yaml to run the RQ workers (see the Workers block below).
#
# 'local-db' runs the bundled MySQL, and is the ONLY setting that decides it —
# the server's depends_on uses `required: false`, so turning this profile off
# for an external database needs no other change.
COMPOSE_PROFILES=local-db

# ---- This stack's identity on a shared host --------------------------------
# On a machine shared with other developers, make these unique (for example
# eyened-yourname) so containers, volumes and ports do not collide.
COMPOSE_PROJECT_NAME=eyened
# Port the platform is served on — this is the URL you open in a browser.
HTTP_PORT=8080
# Port for the bundled Keycloak (development OIDC). Only published when
# compose.oidc.yaml is in COMPOSE_FILE above.
#
# This one IS published on every interface, and that is not an oversight: the
# server container fetches Keycloak's metadata document through the host (see
# compose.yaml), so a loopback-only publish makes OIDC login fail while every
# container still reports healthy. Set KEYCLOAK_ADMIN_PASSWORD below rather
# than leaving an admin console open with a known password.
KEYCLOAK_PORT=8180
# KEYCLOAK_BIND=0.0.0.0
# Hostname or IP you type in the browser. Only required for OIDC redirects.
PUBLIC_HOST=localhost
#
# Behind a TLS-terminating proxy (SURF Research Cloud, any ingress) the
# address a browser uses is a public https:// origin with no port — not this
# stack's host and port. Set PUBLIC_URL to that origin and it replaces
# PUBLIC_HOST:HTTP_PORT in the OIDC redirect URL. Unset = derived from
# PUBLIC_HOST and HTTP_PORT above, which is correct with nothing in front.
# NO TRAILING SLASH. It is not the redirect that breaks: the doubled slash
# (https://host//users/oidc-callback) lands identically in the realm and in
# the URL the server sends, so Keycloak's exact-match check still passes.
# What it corrupts is the realm's webOrigins entry, which becomes
# 'https://host/' — a browser Origin header never carries a trailing slash,
# so that entry can never match one.
# PUBLIC_URL=https://ws.example.src.surf.nl

# ---- Bundled database ------------------------------------------------------
# Where the bundled MySQL keeps its data. Unset = this stack's own named
# volume, which is deleted when the stack is. Set to an absolute path to put
# the database on storage you control:
# DB_DATA_PATH=/home/user/data/eyened-db
#
# Wherever this points at storage that outlives the stack, set the database
# passwords below by hand as well, to the ones the existing database already
# uses. First run GENERATES MYSQL_ROOT_PASSWORD and EYENED_DATABASE_PASSWORD
# whenever deploy/.env is absent, and generated credentials will not open a
# database that is already on that disk — which reads as a config bug rather
# than a lifecycle one.
#
# `./eyened up` and `./eyened install` append MYSQL_ROOT_PASSWORD and
# EYENED_DATABASE_PASSWORD with generated values — but `./eyened prod` (a
# site on an EXTERNAL database) never runs that step: its .env must already
# exist, and once written no entry point ever rewrites it. Set both of these
# by hand there too, even though a site like that never runs the bundled
# MySQL at all: COMPOSE_PROFILES only decides whether compose STARTS the
# 'database' service, not whether it interpolates its environment, so
# ${MYSQL_ROOT_PASSWORD:?...} below is still evaluated and still refuses a
# missing value (measured: 'docker compose config' with COMPOSE_PROFILES=
# and the prod layers fails on exactly this).
#
# They are absent here ON PURPOSE either way: a .env copied from this
# template by hand then fails at 'docker compose up' on that same
# ${MYSQL_ROOT_PASSWORD:?...}, loudly and before anything is built — rather
# than booting the whole stack on a password published in this repository.
EYENED_DATABASE_USER=eyened
EYENED_DATABASE_DATABASE=eyened_database
# Where the server looks for MySQL. 'database' is the bundled container.
EYENED_DATABASE_HOST=database
EYENED_DATABASE_PORT=3306
#
# To use an EXTERNAL database instead:
#   1. remove 'local-db' from COMPOSE_PROFILES above
#   2. point EYENED_DATABASE_* at that server
# Bootstrap then declines to touch it.
#
# The bundled MySQL publishes NO host port by default — that is the single
# biggest source of collisions between developers on one machine. For DBeaver
# or a host-side alembic, append :compose.host-ports.yaml to COMPOSE_FILE and
# pick values nobody else is using:
# DB_PUBLISH_PORT=13306
# REDIS_PUBLISH_PORT=16379

# ---- Redis -----------------------------------------------------------------
# The installer appends EYENED_REDIS_PASSWORD with a generated value; absent
# here for the same reason as the database passwords above.

# ---- API -------------------------------------------------------------------
# The installer appends EYENED_API_SECRET_KEY, the session/JWT signing key,
# with a generated value. Never copy a key between deployments — every stack
# must have its own, which is why this template cannot carry one.
EYENED_API_PUBLIC_AUTH_DISABLED=false
EYENED_API_DEBUG=false
# Whether the login page offers username/password. Turn this off once OIDC is
# working and every account can sign in through the provider — see the OIDC
# block at the end of this file. Leave it unset (or true) and password login
# stays available.
EYENED_API_AUTH_PASSWORD_ENABLED=true
#
# Only for OTHER hosts that read image files through the API instead of from
# disk (notebooks, remote workers) — they read this file, or one like it, with
# their own tooling. They are deliberately NOT passed into the server
# container, which lists its environment explicitly (see compose.yaml): the
# server reads images locally, and an EYENED_API_URL set to the empty string
# would pass pydantic validation and then fail later as a connection error
# instead of the clear "url missing" it raises today.
# EYENED_API_URL=http://localhost:8080/api
# EYENED_API_USERNAME=
# EYENED_API_PASSWORD=

# ---- Storage ---------------------------------------------------------------
# ONE convention, and it is structural rather than documented: the CONTAINER
# path is canonical. Platform storage (thumbnails + segmentations.zarr) is
# ALWAYS /storage inside the container — compose.yaml pins it, and nothing in
# this file can change it. Do not set EYENED_STORAGE_ROOT here; it would be
# ignored, and `./eyened doctor` refuses it for that reason.
#
# Host locations appear ONLY in volume mappings. By default platform storage is
# this stack's own named volume, so a clean clone writes nothing outside itself
# and never touches production data. Opt in to shared or production storage
# with an absolute host path that ALREADY EXISTS — Docker creates an empty
# directory at a bind-mount source that is missing rather than refusing, so a
# typo here is silent:
# PLATFORM_STORAGE_PATH=/mnt/oogergo/eyened/eyened_platform
#
# Image datasets are NOT configured here. They live in storage-mounts.conf,
# from which the container mounts, the nginx routes and EYENED_STORAGE_MOUNTS
# are all generated. Image records store RELATIVE keys resolved through that
# map, which is why no host path is ever baked into the database.
# See deploy/README.md.

# ---- Workers (optional) ----------------------------------------------------
# RQ workers run image models and generate thumbnails. Append
# :compose.workers.yaml to COMPOSE_FILE above to run them on THIS host; they
# then reach redis and the database by service name with nothing published.
#
# The slim ROI worker starts with the layer and needs no profile: it listens on
# `default`, the queue thumbnail jobs go to. The GPU workers are opt-in:
# COMPOSE_PROFILES=local-db,gpu-inference    (also gpu-cfi-amd,
#                                             gpu-layer-segmentation)
#
# COMPOSE_FILE is also what decides which services gen-storage.sh gives the
# image dataset mounts to, so appending the layer above is what puts the
# workers into compose.storage.yaml. It re-runs on every './eyened up'.
#
# On a SEPARATE GPU box, set COMPOSE_FILE to the workers and storage layers
# only —
#   COMPOSE_FILE=compose.workers.yaml:compose.storage.yaml
# — fill in storage-mounts.conf, run deploy/scripts/gen-storage.sh, then
#   docker compose -f deploy/compose.workers.yaml -f deploy/compose.storage.yaml \
#     up -d --build
# and point these at the platform host. PLATFORM_STORAGE_PATH is REQUIRED
# there: its default is this stack's own named volume, which on another machine
# is a new EMPTY one — the workers would start, report healthy, and write
# thumbnails and segmentations where nothing can read them. Nothing catches
# that on a host where './eyened doctor' is not run.
# EYENED_REDIS_HOST=platform.example.org
# EYENED_DATABASE_HOST=platform.example.org
#
# Queue lists. Running the GPU inference worker beside the slim one
# double-consumes `default` and `cfi-roi`; drop them here if you want each job
# handled once.
# EYENED_RQ_QUEUES_CFI_ROI=cfi-roi,default
# EYENED_RQ_QUEUES_INFERENCE=cfi-keypoints,cfi-odfd,cfi-quality

# ---- OIDC (optional) -------------------------------------------------------
# Append :compose.oidc.yaml to COMPOSE_FILE above to run the bundled Keycloak,
# and set PUBLIC_HOST (above) to the hostname you use in the browser — not
# 'localhost', which inside the server container resolves to the container
# itself. Behind a TLS proxy set PUBLIC_URL (above) instead. See
# deploy/keycloak/README.md.
#
# Turning this on requires EYENED_OIDC_METADATA_URL below to be set as well —
# its default is empty, nothing derives it for you any more, whether you use
# the bundled Keycloak (compose.oidc.yaml) or an external provider.
# `./eyened doctor` refuses to build while this is on and EYENED_OIDC_METADATA_URL
# is empty, rather than let login fail at runtime.
# EYENED_API_AUTH_OIDC_ENABLED=true
# EYENED_OIDC_CLIENT_ID=eyened-platform
# EYENED_OIDC_CLIENT_SECRET=eyened-dev-secret   # must match realm-eyened-dev.json.template
# EYENED_OIDC_PROVIDER_NAME=Keycloak
# EYENED_OIDC_CREATE_NEW_ACCOUNTS=true
#
# The three below are NOT derived from anything — the bundled Keycloak and an
# external provider are configured identically. For the BUNDLED realm,
# uncomment exactly these three, with <PUBLIC_HOST> replaced by the same
# value set for PUBLIC_HOST above. Do not leave it as 'localhost': inside the
# server container that name resolves to the container itself (::1, then
# 127.0.0.1 — both refused) before falling through to the host-gateway alias
# this layer adds, so every token validation pays two refused connections
# before succeeding.
# EYENED_OIDC_METADATA_URL=http://<PUBLIC_HOST>:8180/realms/eyened-dev/.well-known/openid-configuration
# EYENED_OIDC_REDIRECT_URL=http://<PUBLIC_HOST>:8080/users/oidc-callback
# EYENED_OIDC_ADDITIONAL_TOKEN_VALIDATIONS=iss=http://<PUBLIC_HOST>:8180/realms/eyened-dev
#
# For an EXTERNAL provider (SURFconext, Entra, Okta) set ALL THREE TOGETHER: a
# metadata URL at the new provider with a redirect URL or an iss= left on the
# dev realm fails token validation with nothing in the log to say why.
# EYENED_OIDC_METADATA_URL=https://connect.surfconext.nl/.well-known/openid-configuration
# EYENED_OIDC_REDIRECT_URL=https://eyened.example.org/users/oidc-callback
# EYENED_OIDC_ADDITIONAL_TOKEN_VALIDATIONS=iss=https://connect.surfconext.nl
#
# Bootstrap admin password for the BUNDLED Keycloak's admin console, which is
# published on every interface (see KEYCLOAK_BIND above).
#
# The installer appends KEYCLOAK_ADMIN_PASSWORD with a generated value, like
# the database passwords above — read it out of deploy/.env when you need the
# console. It is absent here for the same reason, but this one is NOT caught by
# compose: compose.oidc.yaml has ${KEYCLOAK_ADMIN_PASSWORD:-admin}, a default
# rather than a requirement, so absent means the console comes up on
# admin/admin and compose says nothing. `./eyened doctor` is the backstop, and
# REFUSES to build with compose.oidc.yaml in COMPOSE_FILE while this is absent,
# empty, 'admin' or 'change_me' — covering a hand-written .env, or one that
# predates this.
#
# Keycloak re-reads this on every RECREATE, not just the first, because the
# service keeps no volume — see deploy/keycloak/README.md. Editing it and
# running `docker compose restart` changes nothing; the container has to be
# recreated for a new value to take effect.
