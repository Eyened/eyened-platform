FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ARG MEDSAM2_GIT_URL=https://github.com/ImprintLab/Medical-SAM2.git
ARG MEDSAM2_GIT_REF=main

RUN set -eux; \
        for i in 1 2 3; do \
            apt-get update && \
            apt-get install -y --no-install-recommends --fix-missing \
                git libxcb1 libgl1 libglib2.0-0 && break; \
            echo "apt install failed (attempt $i), retrying..."; \
            sleep 5; \
            rm -rf /var/lib/apt/lists/*; \
        done; \
        apt-get clean; \
        rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONPATH=/app/MedSAM/Medical-SAM2-main:${PYTHONPATH}

COPY MedSAM /app/MedSAM
COPY medsam_service /app/medsam_service

RUN test -f /app/MedSAM/medsam2.pth || (echo "Missing MedSAM checkpoint at MedSAM/medsam2.pth" && exit 1)
RUN if [ ! -f /app/MedSAM/Medical-SAM2-main/sam2_train/__init__.py ]; then \
        echo "Medical-SAM2 source missing from build context; cloning from ${MEDSAM2_GIT_URL}@${MEDSAM2_GIT_REF}"; \
        rm -rf /app/MedSAM/Medical-SAM2-main; \
        git clone --depth 1 --branch "${MEDSAM2_GIT_REF}" "${MEDSAM2_GIT_URL}" /app/MedSAM/Medical-SAM2-main; \
    fi \
    && test -f /app/MedSAM/Medical-SAM2-main/sam2_train/__init__.py || (echo "Missing Medical-SAM2 source at MedSAM/Medical-SAM2-main" && exit 1)

RUN pip install --no-cache-dir -r /app/medsam_service/requirements.txt \
    && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.4.0 torchvision==0.19.0 \
    && pip install --no-cache-dir pillow==10.4.0 tqdm==4.66.4 yacs==0.1.8 iopath==0.1.10 opencv-python==4.10.0.84

EXPOSE 8010

CMD ["uvicorn", "medsam_service.main:app", "--host", "0.0.0.0", "--port", "8010"]
