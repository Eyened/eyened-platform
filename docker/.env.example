# Copy to .env and adjust. Do not commit real secrets.

PORT=80
EYENED_API_SECRET_KEY=change_me_to_a_long_random_secret

# Database (use host.docker.internal when MySQL runs on the Docker host)
EYENED_DATABASE_HOST=host.docker.internal
EYENED_DATABASE_PORT=3306
EYENED_DATABASE_USER=eyened
EYENED_DATABASE_PASSWORD=change_me
EYENED_DATABASE_DATABASE=eyened_database

# --- Redis (RQ job broker) ---
EYENED_REDIS_PASSWORD=change_me_to_a_long_random_secret
EYENED_REDIS_PUBLISH_PORT=6379

# Writable host path mounted into containers (thumbnails/, segmentations.zarr)
EYENED_STORAGE_ROOT=/storage

# --- API concurrency (defaults shown; uncomment a line to change it) ---
# WORKERS is the gunicorn worker-process count, default 4. Each server process
# has its own pool and can open up to EYENED_API_POOL_SIZE +
# EYENED_API_MAX_OVERFLOW connections, so at peak the database sees 4 x 20 =
# 80 from the API alone.
# Keep that total -- plus the RQ worker and the importer -- under the database
# server's max_connections; check what yours is set to before raising WORKERS.
# EYENED_API_THREADPOOL_LIMIT must not exceed POOL_SIZE + MAX_OVERFLOW: the
# server refuses to start otherwise ("Worker failed to boot"), so to use fewer
# connections per process lower all three together.
# EYENED_API_POOL_TIMEOUT is outside that check: 5s turns pool exhaustion into
# a fast error instead of a 30-second hang.
# WORKERS=4
# EYENED_API_THREADPOOL_LIMIT=16
# EYENED_API_POOL_SIZE=16
# EYENED_API_MAX_OVERFLOW=4
# EYENED_API_POOL_TIMEOUT=5
